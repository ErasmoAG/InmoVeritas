# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Genera las claves con:  python scripts/setup_env.py

# Clave maestra (base64, 32 bytes). Envuelve las claves de cada expediente.
INMO_MASTER_KEY=
# Secreto para firmar sesiones y enlaces de recepcion.
INMO_SESSION_SECRET=

# Modelo local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=45

# Almacenamiento y reglas
INMO_STORAGE_DIR=storage
INMO_RULES_FILE=config/rules_config.yaml

# Limites de recepcion
MAX_FILE_MB=60
MAX_FILES_PER_SUBMISSION=40
MAX_PAGES_PER_DOC=120
MAX_OCR_PAGES_PER_DOC=30
ZIP_MAX_UNCOMPRESSED_MB=300
ZIP_MAX_FILES=60
ZIP_MAX_RATIO=100

# Panel del abogado (usuario creado con scripts/create_user.py)
INMO_BASE_URL=http://localhost:8000

# OCR: rapidocr (preciso, ~2 s/pagina en CPU) | windows (rapido, ~0.2 s/pagina, solo Windows; menos fiable con digitos)
OCR_ENGINE=rapidocr
OCR_DPI=150
# Umbrales de calidad de imagen (ajustables; no son prueba definitiva de legibilidad)
QUALITY_BLUR_WARN=120
QUALITY_BLUR_CRITICAL=40
QUALITY_CONTRAST_WARN=100
QUALITY_CONTRAST_CRITICAL=45
OCR_MIN_CONFIDENCE=0.6
